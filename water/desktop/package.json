{
  "name": "alfath-water",
  "productName": "AlFath-Water",
  "version": "1.1.0",
  "description": "جمعية الفتح للتنمية والتعاون - تدبير الماء الصالح للشرب",
  "author": "Association Al Fath",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ma.alfath.water",
    "productName": "AlFath-Water",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "backup.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ماء الفتح",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AlFath-Water-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AlFath-Water-Portable-${version}.exe"
    }
  }
}